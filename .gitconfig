[alias]
  amend = commit --amend
  ci = commit
  co = checkout
  coax = !git checkout develop_ax_deploy 2>/dev/null || git checkout develop_ax
  coeco = checkout develop_eco
  coegg = checkout develop_egg
  cofix = checkout sass-temp-fix
  coma = !git checkout master 2>/dev/null || git checkout main
  core = checkout release
  corema = !git checkout release 2>/dev/null || git checkout master 2>/dev/null || git checkout main
  cp = cherry-pick
  curbr = branch --show-current
  fwl = push --force-with-lease
  mt = mergetool
  pushup = push -u origin HEAD
  stat = status
  wc = whatchanged
[diff]
  tool = vimdiff
[merge]
  tool = vimdiff
[user]
  email = james.white@firstup.io
  name = James White
[safe]
  directory = *
[pull]
  ff = only
